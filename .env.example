# ─────────────────────────────────────────────────────────────
# Datastraw CX Assistant — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER put a service-role key or AI API key in a VITE_ variable
# — those are bundled into client-side JS and exposed in the browser!
# ─────────────────────────────────────────────────────────────

# ── 1. Client-Side Variables (Browser Accessible) ─────────────
# Supabase project URL (safe to expose — it's a public API endpoint)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose — Row Level Security restricts access)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── 2. Server-Side Secrets (Supabase Edge Function Secrets) ───
# These secrets MUST NEVER be prefixed with VITE_ or placed in client code.
# Configure them in your Supabase project using the Supabase CLI or Dashboard:
#
# Using the Supabase CLI:
#   supabase secrets set OPENROUTER_API_KEY=sk-or-v1-...
#   supabase secrets set OPENROUTER_MODEL=google/gemini-2.5-flash
#
# Or in the Supabase Dashboard:
#   Project Settings -> Edge Functions -> Secrets
#
# Optional Configuration:
#   OPENROUTER_MODEL=google/gemini-2.5-flash   (default: google/gemini-2.5-flash, or openai/gpt-4o-mini)
#   SUPABASE_SERVICE_ROLE_KEY=<managed automatically by Supabase Edge Runtime>
